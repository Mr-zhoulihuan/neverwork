// NeverWork 的 Windows 资源：应用图标 + 版本信息。
// 由 crates/app/build.rs 通过 embed-resource 交给 rc.exe 编译后链接进 exe。
// 图标与 installer/make_icon.py 生成的是同一份 crates/app/assets/neverwork.ico。
// 版本号与 workspace 版本保持一致（发版时两处一起改）。

1 ICON "neverwork.ico"

1 VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "NeverWork"
            VALUE "FileDescription", "NeverWork"
            VALUE "FileVersion", "0.2.0"
            VALUE "LegalCopyright", "Apache-2.0"
            VALUE "OriginalFilename", "neverwork.exe"
            VALUE "ProductName", "NeverWork"
            VALUE "ProductVersion", "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
